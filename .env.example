# Copy to .env and adapt. The .env file is ignored by git: never commit a real key.
POSTGRES_USER=smartcheckout
POSTGRES_PASSWORD=smartcheckout

# AI agent (agent-service). Leave AI_CHAT_MODEL=none to run without AI (rule-based reports).
# Free key: https://aistudio.google.com/apikey
AI_CHAT_MODEL=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AGENT_DAILY_BUDGET=50
